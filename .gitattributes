# Normalise line endings across Linux, macOS and Windows checkouts.
* text=auto eol=lf

# Windows batch files must keep CRLF to run reliably.
*.bat  text eol=crlf

# Shell scripts must stay LF even on Windows checkouts.
*.sh   text eol=lf

# Binary assets — never convert line endings.
*.ttf   binary
*.woff  binary
*.woff2 binary
*.pdf   binary
*.png   binary
*.ico   binary
